# Публічні ключі Supabase. Next.js віддає у браузер лише змінні з префіксом
# NEXT_PUBLIC_, тому назви саме такі. Обидва значення — публічні за задумом:
# доступ обмежують RLS-політики, а не таємність ключа.
#
# Взяти тут: Supabase → Project Settings → API Keys
# Без них застосунок працює в локальному режимі (localStorage + демо-рецепти).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
