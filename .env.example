# Публічні ключі Supabase. Next.js віддає у браузер лише змінні з префіксом
# NEXT_PUBLIC_, тому назви саме такі. Обидва значення — публічні за задумом:
# доступ обмежують RLS-політики, а не таємність ключа.
#
# Взяти тут: Supabase → Project Settings → API Keys
# Без них застосунок працює в локальному режимі (localStorage + демо-рецепти).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Пуш-сповіщення ───────────────────────────────────────────────────────────
# Потрібні лише для нагадувань про строки придатності й сповіщень про
# коментарі. Без них застосунок працює як раніше, просто мовчки: перемикач у
# налаштуваннях не зʼявляється, а маршрути розсилки відповідають 503.
#
# Пара ключів VAPID — згенеруй СВОЮ одним рядком і нікому не показуй приватну:
#   npx web-push generate-vapid-keys
#
# Публічний можна назвати і VAPID_PUBLIC_KEY: браузер бере його з /api/push/key,
# а не з бандла. Так зроблено тому, що змінну з префіксом NEXT_PUBLIC_ не можна
# позначити sensitive у Vercel — префікс якраз і означає «віддати у браузер».
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Службовий ключ Supabase (Project Settings → API Keys → service_role).
# Дає повний доступ до бази в обхід RLS — саме тому живе тільки на сервері й
# ніколи не має префікса NEXT_PUBLIC_. Потрібен, щоб розсилка бачила чужі
# підписки: RLS навмисно цього не дозволяє.
SUPABASE_SERVICE_ROLE_KEY=

# Спільний секрет, яким вебхук бази доводить своє право розсилати.
# Будь-який довгий випадковий рядок: openssl rand -base64 32
PUSH_SECRET=

# Те саме для щоденного розкладу Vercel. Vercel підставляє цей заголовок сам,
# змінна має називатись саме так.
CRON_SECRET=
